{
  "name": "mmimage-links",
  "author": "wj03",
  "description": "跨平台写真网站导航与网址可达性检测工具",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "compile": "tsc -b && vite build",
    "build": "npm run build:desktop",
